{
  "name": "mcp-server-bitbucket",
  "version": "0.18.1",
  "description": "MCP server for Bitbucket API operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-bitbucket": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "bitbucket",
    "api",
    "claude",
    "ai",
    "model-context-protocol"
  ],
  "author": "Javier Aguilar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaviMaligno/mcp-server-bitbucket"
  },
  "homepage": "https://github.com/JaviMaligno/mcp-server-bitbucket#readme",
  "bugs": {
    "url": "https://github.com/JaviMaligno/mcp-server-bitbucket/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "jose": "^6.2.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "tsup": "8.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "vite": "^8.3.5",
    "esbuild": "^0.28.1"
  }
}
