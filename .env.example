# Bitbucket API credentials
BITBUCKET_WORKSPACE=simplekyc

# Basic auth (personal Atlassian API token, ATATT...)
BITBUCKET_EMAIL=your-email@example.com
BITBUCKET_API_TOKEN=your-api-token

# Bearer auth (workspace/project/repository access token, ATCTT...)
# Set this instead of EMAIL/API_TOKEN to authenticate as the workspace itself
#BITBUCKET_OAUTH_TOKEN=your-workspace-access-token
# Optional override: basic | bearer (auto-detected when unset)
#BITBUCKET_AUTH_TYPE=

# Optional: Default project key for new repos
BITBUCKET_PROJECT_KEY=

# --- Remote deployments only: gate /mcp on an OAuth bearer token ---
# Unset = no authentication (fine for stdio/local use). See README.
#MCP_OAUTH_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
#MCP_OAUTH_AUDIENCE=api://bitbucket-mcp
#MCP_OAUTH_REQUIRED_SCOPE=mcp.access
#MCP_PUBLIC_URL=https://bitbucket-mcp.example.com
